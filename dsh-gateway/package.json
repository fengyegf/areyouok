{
  "name": "dsh-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 局域网/公网转发网关插件：把本机 DSH 的会话、消息、审批能力以稳定的 /v1 协议暴露给局域网/公网设备（APK 客户端），自带 mDNS 发现、扫码配对、设备令牌与审批补发。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "bonjour-service": "^1.4.4",
    "ipaddr.js": "^2.5.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^4.0.1",
    "ws": "^8.22.1"
  }
}
